# Variáveis de ambiente do app (copie para .env e preencha). NÃO commitar o .env.

# Supabase — URL e chave pública (anon/publishable). Seguras para o front (respeitam RLS).
NEXT_PUBLIC_SUPABASE_URL=https://[REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Supabase service role — SÓ no servidor (bypassa RLS). Nunca no front/Git.
SUPABASE_SERVICE_ROLE_KEY=

# IA (Anthropic / Claude)
ANTHROPIC_API_KEY=

# ASAAS (REST) — usar sandbox primeiro
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# Banco direto (drizzle-kit migrations) — opcional; as migrations também rodam via MCP
DATABASE_URL=
